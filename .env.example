# ─── Required ─────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# ─── Storage (defaults shown) ─────────────────────────────────────────────────
# Paths are relative to the working directory unless absolute.
DB_PATH=platform.db
LANCEDB_PATH=platform_lancedb
SOURCES_DIR=platform_sources

# Override only if you keep the benchmark CSV outside the package.
# BENCHMARK_CSV_PATH=

# ─── Models ───────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── RAG ──────────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_DISTANCE_HIGH=0.30
RAG_DISTANCE_MEDIUM=0.50
RAG_DISTANCE_LOW=0.65

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Number of worker processes for the async ingestion pool. Defaults to
# min(4, os.cpu_count()).
# INGEST_WORKERS=4

# ─── Previews ─────────────────────────────────────────────────────────────────
PREVIEW_DPI_SCALE=1.5
